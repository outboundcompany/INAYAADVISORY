    {
      "source": "/education",
      "destination": "/insights#education",
      "permanent": true
    },
    {
      "source": "/education/how-a-raise-runs",
      "destination": "/insights#education",
      "permanent": true
    },
    {
      "source": "/education/what-a-committee-asks",
      "destination": "/insights#education",
